SESTELEMETRY_COLLECTOR_IMAGE=ghcr.io/your-org/sestelemetry-collector:latest
SESTELEMETRY_API_IMAGE=ghcr.io/your-org/sestelemetry-api:latest
SESTELEMETRY_WEB_IMAGE=ghcr.io/your-org/sestelemetry-web:latest
SESTELEMETRY_WEB_API_BASE_URL=
# Must name the web origin (e.g. http://SERVER_IP:5173) when
# SESTELEMETRY_WEB_API_BASE_URL points the browser straight at the API:
# the session cookie never crosses origins to "*".
SESTELEMETRY_API_ALLOW_ORIGIN=*
# true only when the dashboard is served over HTTPS.
SESTELEMETRY_API_COOKIE_SECURE=false
# Optional first administrator (password ≥ 10 characters), created on API
# start while no account exists. Left empty, the API creates admin/admin,
# which must set its own password at the first sign-in.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
SESTELEMETRY_DB_USER=postgres
SESTELEMETRY_DB_PASSWORD=change-me
SESTELEMETRY_DB_NAME=telemetry
SESTELEMETRY_DATABASE_URL=postgres://postgres:change-me@timescaledb:5432/telemetry?sslmode=disable
SESTELEMETRY_HOST_CONFIG_PATH=/etc/sestelemetry/config.yaml
SESTELEMETRY_HOST_REGISTERS_PATH=/etc/sestelemetry/registers
