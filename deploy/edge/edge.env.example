# EMS edge environment — copy to /etc/ems-edge/edge.env on the device.
#   sudo install -m 600 -o root -g root edge.env.example /etc/ems-edge/edge.env
# The systemd unit loads it via EnvironmentFile=. Secrets and hosts live
# ONLY here — never in config.yaml (it is safe to commit / copy around).

# --- SmartLogger hosts (referenced from config.yaml as ${VAR}) ---
# Single-SmartLogger topology (ab):
EDGE_SL_HOST=192.168.8.10
# Dual-SmartLogger topology (ze) — uncomment and switch config.yaml:
#EDGE_SL_PV_HOST=10.28.40.101
#EDGE_SL_ESS_HOST=10.28.40.102

# --- Cloud uplink ---
# Base URL of the sestelemetry API (no trailing slash).
EDGE_CLOUD_URL=https://telemetry.example.com

# Per-site Bearer token. The variable NAME must match
# uplink.site_token_env in config.yaml, and the value must match the
# site's entry in EDGE_SITE_TOKENS on the cloud API.
EMS_SITE_TOKEN_AB=change-me
