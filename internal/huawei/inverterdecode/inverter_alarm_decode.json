  "title": "Huawei SUN2000 alarm/status decode (SmartLogger remapped 51xxx)",
  "sources": [
    {
      "id": "smartlogger-modbus-table-2-7",
      "path": "docs/references/huawei/smartlogger-modbus-interface-definitions-v300r024-issue52.pdf",
      "section": "Table 2-7 Inverter Register Definitions",
      "note": "Major/Minor/Warning U32 = Alarm ID (bits 31–16) + Cause ID (bits 15–0); offsets 12/14/16"
    },
    {
      "id": "sun2000-modbus-table-5-1",
      "path": "SUN2000 Modbus Interface Definitions (not stored in repo)",
      "section": "Table 5-1 Alarm information",
      "note": "Alarm ID, level, bit in registers 32008–32010"
    },
    {
      "id": "huawei-alarm-reference",
      "url": "https://support.huawei.com/enterprise/en/doc/EDOC1100345192",
      "section": "Inverter Alarm Reference",
      "note": "Cause ID details per alarm ID"
    }
  ],
  "decode": {
    "fault_u32": {
      "description": "Remapped per-inverter Major/Minor/Warning at offsets 12, 14, 16 (U32 each).",
      "alarm_id_mask": "0xFFFF0000",
      "cause_id_mask": "0x0000FFFF",
      "alarm_id_shift": 16,
      "steps": [
        "Parse hex string to unsigned 32-bit integer.",
        "If value is 0, return empty decode.",
        "alarm_id = (value >> 16) & 0xFFFF",
        "cause_id = value & 0xFFFF",
        "Lookup alarms[String(alarm_id)]; format cause via cause_id rules."
      ],
      "example": {
        "hex": "0x7DC0003",
        "alarm_id": 2012,
        "cause_id": 3,
        "summary_en": "String Current Backfeed · PV string 3",
        "summary_uk": "Зворотний струм стрінгу · PV стрінг 3"
      }
    },
    "status_u16": {
      "description": "Inverter status at remapped offset 9 (same enum as SUN2000 register 32089). SmartLogger may also report 0xB000 (comm interrupt) and 0xC000 (uploading).",
      "register_sun2000": 32089
    }
  },
  "cause_id_patterns": {
    "pv_string_index": {
      "description": "Cause ID 1…n maps to PV string 1…n (Huawei Alarm Reference).",
      "label_en": "PV string {n}",
      "label_uk": "PV стрінг {n}",
      "max_n": 36
    },
    "grid_loss": {
      "description": "Alarm 2032 Grid Loss.",
      "values": {
        "1": {
          "name_en": "Grid outage or AC circuit disconnected",
          "name_uk": "Відсутність мережі або розімкнутий AC"
        }
      },
      "fallback_en": "Cause ID {n}",
      "fallback_uk": "Cause ID {n}"
    },
    "none": {
      "description": "No per-cause table in Alarm Reference; show numeric Cause ID if non-zero.",
      "fallback_en": "Cause ID {n}",
      "fallback_uk": "Cause ID {n}"
    }
  },
